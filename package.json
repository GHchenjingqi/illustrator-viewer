{
  "name": "illustrator-viewer",
  "version": "0.7.0",
  "description": "Illustrator Viewer - 浏览器本地解析 Adobe Illustrator .ai 文件并渲染 Canvas 预览（Vue 3 / JS + WASM）。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GHchenjingqi/illustrator-viewer.git"
  },
  "homepage": "https://github.com/GHchenjingqi/illustrator-viewer#readme",
  "bugs": {
    "url": "https://github.com/GHchenjingqi/illustrator-viewer/issues"
  },
  "keywords": [
    "adobe-illustrator",
    "illustrator",
    "ai-file",
    "ai-viewer",
    "illustrator-viewer",
    "illustrator-parser",
    "postscript",
    "eps",
    "vector-graphics",
    "canvas",
    "canvas-renderer",
    "vue",
    "vue3",
    "wasm",
    "parser",
    "preview",
    "scene-graph",
    "file-viewer"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/illustrator-viewer.js",
  "module": "./dist/illustrator-viewer.js",
  "exports": {
    ".": {
      "import": "./dist/illustrator-viewer.js",
      "default": "./dist/illustrator-viewer.js"
    },
    "./style.css": "./dist/style.css",
    "./wasm/ai_viewer_wasm.wasm": "./dist/wasm/ai_viewer_wasm.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-package.mjs",
    "build:lib": "node scripts/build-package.mjs",
    "build:demo": "vite build --outDir dist-demo",
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepack": "node scripts/build-package.mjs",
    "benchmark:wasm": "node scripts/benchmark-wasm.mjs",
    "preview": "vite preview --outDir dist-demo",
    "pretest": "node scripts/generate-synthetic-samples.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "inspect": "node scripts/inspect-ai.mjs",
    "generate:samples": "node scripts/generate-synthetic-samples.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "fzstd": "^0.1.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.45"
  }
}
